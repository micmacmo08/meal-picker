 "meals": [
  {
   "id": 1,
   "name": "Ground Turkey Tacos",
   "ingredients": "1 lb ground turkey\n2 tbsp taco seasoning\n12 corn tortillas\n0.5 onion diced\n0.25 cup cilantro chopped\n1 lime cut into wedges\n2 cups lettuce shredded\n1 cup cheddar shredded\n0.5 cup salsa",
   "recipe": "Brown the turkey in a skillet over medium-high heat, breaking it up, about 6-8 minutes. Stir in the taco seasoning and a splash of water; simmer 2 minutes. Warm the tortillas. Assemble tacos with turkey, onion, cilantro, lettuce, cheddar, salsa, and lime.",
   "hidden": 0,
   "created_at": 1792081251752,
   "updated_at": 1792081251752
  },
  {
   "id": 2,
   "name": "Weeknight Chicken Stir-Fry",
   "ingredients": "1 lb chicken breast sliced thin\n2 cups broccoli cut into florets\n2 bell pepper sliced\n1 cup snap peas\n3 tbsp soy sauce\n1 tbsp honey\n2 cloves garlic minced\n1 tbsp ginger grated\n1 tbsp vegetable oil\n1 cup rice uncooked, for serving",
   "recipe": "Start the rice. Heat the oil in a wok or large skillet over high heat. Sear the chicken 3-4 minutes until cooked through; remove. Stir-fry the broccoli, peppers, and snap peas 4-5 minutes until crisp-tender. Return the chicken, add soy sauce, honey, garlic, and ginger, and toss 1 minute. Serve over rice.",
   "hidden": 0,
   "created_at": 1792081252423,
   "updated_at": 1792081252423
  },
  {
   "id": 3,
   "name": "Crockpot Pulled Pork",
   "ingredients": "3 lb pork shoulder bone-in\n1 onion quartered\n4 cloves garlic smashed\n2 tbsp brown sugar packed\n1 tbsp smoked paprika\n1 tbsp salt kosher\n1 tsp black pepper\n0.5 cup apple cider vinegar\n0.5 cup chicken broth\n1 pack hamburger buns for serving",
   "recipe": "Rub the pork all over with the brown sugar, paprika, salt, and pepper. Place in the crockpot with the onion, garlic, vinegar, and broth. Cook on low 8-10 hours until it falls apart. Shred, discard the bone, and toss the meat with the cooking juices. Serve on buns.",
   "hidden": 0,
   "created_at": 1792081252451,
   "updated_at": 1792081252451
  },
  {
   "id": 5,
   "name": "Crockpot Chicken Tortilla Soup",
   "ingredients": "1.5 lb chicken breast boneless skinless\n4 cups chicken broth low-sodium\n1 can (15 oz) black beans drained and rinsed\n1 can (15 oz) corn drained\n1 can (10 oz) diced tomatoes with green chiles\n1 onion diced\n3 cloves garlic minced\n1 tbsp chili powder\n1 tsp cumin ground\n1 lime cut into wedges\n1 bag tortilla chips for serving",
   "recipe": "Add everything except the lime and tortilla chips to the crockpot. Cook on low 6-7 hours or high 3-4 hours. Shred the chicken with two forks and stir it back in. Serve with lime wedges and tortilla chips.",
   "hidden": 0,
   "created_at": 1792081293021,
   "updated_at": 1792081293021
  },
  {
   "id": 6,
   "name": "Sheet-Pan Sausage & Veggies",
   "ingredients": "1 lb Italian sausage cut into chunks\n1.5 lb baby potatoes halved\n2 bell pepper chunked\n1 red onion wedged\n1 zucchini cut into half-moons\n2 tbsp olive oil\n1 tbsp Italian seasoning\n1 tsp salt",
   "recipe": "Heat oven to 425F. Toss everything with the olive oil, Italian seasoning, and salt on a large sheet pan. Roast 25-30 minutes, flipping once, until the potatoes are tender and the sausage is browned.",
   "hidden": 0,
   "created_at": 1792081293501,
   "updated_at": 1792081293501
  },
  {
   "id": 7,
   "name": "Spaghetti with Meat Sauce",
   "ingredients": "1 lb spaghetti\n1 lb ground beef\n1 onion diced\n3 cloves garlic minced\n1 can (28 oz) crushed tomatoes\n2 tbsp tomato paste\n1 tbsp Italian seasoning\n0.5 cup parmesan grated",
   "recipe": "Brown the beef with the onion and garlic over medium-high heat, 6-8 minutes. Stir in the tomato paste, crushed tomatoes, and Italian seasoning. Simmer at least 20 minutes (longer is better). Cook the spaghetti, then serve topped with sauce and parmesan.",
   "hidden": 0,
   "created_at": 1792081299340,
   "updated_at": 1792081299340
  },
  {
   "id": 8,
   "name": "Sunday Beef Stew",
   "ingredients": "2 lb beef chuck cut into 1.5-inch cubes\n2 onion chopped\n4 carrots cut into chunks\n3 stalks celery sliced\n1.5 lb baby potatoes halved\n4 cups beef broth\n2 tbsp tomato paste\n0.25 cup flour\n1 tsp thyme dried\n2 bay leaf\n2 tbsp olive oil",
   "recipe": "Toss the beef with the flour, salt, and pepper. Sear in the oiled pot over medium-high heat until browned on all sides. Add the onions, carrots, celery, tomato paste, broth, thyme, and bay leaves. Simmer gently 2-2.5 hours, adding the potatoes for the last 45 minutes, until the beef is tender. Remove the bay leaves before serving.",
   "hidden": 0,
   "created_at": 1792081304386,
   "updated_at": 1792081304386
  },
  {
   "id": 9,
   "name": "Shakshuka",
   "ingredients": "8 eggs\n1 can (28 oz) crushed tomatoes\n1 onion diced\n1 bell pepper diced\n3 cloves garlic minced\n1 tsp cumin\n1 tsp smoked paprika\n2 tbsp olive oil\n0.5 cup feta crumbled\n1 loaf crusty bread for serving",
   "recipe": "Saute the onion, bell pepper, and garlic in the olive oil until soft, about 6 minutes. Stir in the cumin and paprika, then the crushed tomatoes; simmer 10 minutes. Make 8 wells and crack an egg into each. Cover and cook 5-7 minutes until the whites are set. Top with feta and serve with crusty bread.",
   "hidden": 0,
   "created_at": 1792081304906,
   "updated_at": 1792081304906
  },
  {
   "id": 10,
   "name": "Red Lentil & Chickpea Harissa Stew",
   "ingredients": "2 cups red lentils rinsed\n2 can (15 oz) chickpeas drained and rinsed\n1 onion diced\n2 carrots diced\n4 cloves garlic minced\n2 tbsp harissa paste\n1 can (28 oz) crushed tomatoes\n6 cups vegetable broth\n2 tbsp olive oil\n1 tsp cumin ground\n4 cups spinach fresh\n1 lemon juiced, for serving",
   "recipe": "Saute the onion and carrots in the olive oil until soft, about 6 minutes. Add the garlic, harissa, and cumin; cook 1 minute until fragrant. Add the lentils, chickpeas, crushed tomatoes, and broth. Simmer 25 minutes, stirring occasionally, until the lentils break down and the stew thickens. Stir in the spinach until wilted. Finish with lemon juice and serve with crusty bread.",
   "hidden": 0,
   "created_at": 1792081312988,
   "updated_at": 1792081312988
  },
  {
   "id": 11,
   "name": "Greek Chicken Souvlaki Bowls",
   "ingredients": "2 lb chicken thighs boneless skinless, cut into 1-inch pieces\n0.25 cup olive oil\n2 lemon juiced\n4 cloves garlic minced\n2 tsp oregano dried\n1.5 cups rice uncooked\n1 cucumber diced\n2 cups cherry tomatoes halved\n0.5 red onion thinly sliced\n0.75 cup feta crumbled\n1 cup Greek yogurt plain, for tzatziki\n2 tbsp dill chopped, for tzatziki",
   "recipe": "Marinate the chicken in the olive oil, lemon juice, garlic, oregano, salt, and pepper for 30 minutes (or overnight). Cook the rice. Sear the chicken in a hot skillet with a little oil, 8-10 minutes, until charred at the edges and cooked through. Stir the yogurt with the dill and a pinch of garlic and salt for a quick tzatziki. Serve the chicken over rice with cucumber, tomatoes, red onion, feta, and tzatziki.",
   "hidden": 0,
   "created_at": 1792081313552,
   "updated_at": 1792081313552
  },
  {
   "id": 12,
   "name": "Mediterranean White Bean & Kale Soup",
   "ingredients": "2 can (15 oz) cannellini beans drained and rinsed\n1 bunch kale stems removed, chopped\n1 onion diced\n2 carrots sliced\n2 stalks celery sliced\n4 cloves garlic minced\n6 cups vegetable broth\n1 can (14 oz) crushed tomatoes\n2 tbsp olive oil\n1 tsp rosemary dried\n1 parmesan rind optional\n1 lemon juiced",
   "recipe": "Saute the onion, carrots, and celery in the olive oil until soft, 6-8 minutes. Add the garlic and rosemary; cook 1 minute. Add the broth, crushed tomatoes, beans, and parmesan rind. Simmer 20 minutes. Add the kale and cook 5 minutes more, until tender. Remove the rind, stir in the lemon juice, and serve.",
   "hidden": 0,
   "created_at": 1792081324516,
   "updated_at": 1792081324516
  },
  {
   "id": 13,
   "name": "Slow-Roasted Greek Lemon Chicken & Potatoes",
   "ingredients": "3 lb chicken thighs bone-in skin-on\n2 lb baby potatoes halved\n3 lemon 2 juiced, 1 cut into wedges\n0.33 cup olive oil\n6 cloves garlic smashed\n1 tbsp oregano dried\n1 cup chicken broth",
   "recipe": "Heat the oven to 375F. Whisk the lemon juice, olive oil, garlic, oregano, salt, and pepper. Arrange the chicken and potatoes in a large baking dish, pour over the marinade and the chicken broth, and turn to coat. Roast 1 hour 15 minutes to 1 hour 30 minutes, turning the potatoes once, until the chicken is golden and cooked through and the potatoes are crisp. Serve with the lemon wedges and pan juices.",
   "hidden": 0,
   "created_at": 1792081324938,
   "updated_at": 1792081324938
  },
  {
   "id": 14,
   "name": "Chicken Shawarma Sheet Pan",
   "ingredients": "2 lb chicken thighs boneless skinless\n3 tbsp olive oil\n2 tbsp shawarma seasoning\n1 red onion wedged\n2 bell pepper sliced\n2 cups cherry tomatoes halved\n6 pita bread for serving\n1 cup Greek yogurt for serving\n1 cucumber diced, for serving",
   "recipe": "Heat the oven to 425F. Toss the chicken, onion, bell peppers, and tomatoes with the olive oil and shawarma seasoning on a large sheet pan. Roast 20-25 minutes, until the chicken is cooked through and the vegetables are charred at the edges. Slice the chicken and serve in warm pitas with yogurt and cucumber.",
   "hidden": 0,
   "created_at": 1792081324970,
   "updated_at": 1792092824037
  }
 ],
