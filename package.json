{"dependencies":{"@tanstack/react-query":"^5.104.5","better-sqlite3":"^12.2.0","drizzle-orm":"^0.45.2","express":"^4.21.2","react":"^19.3.1","react-dom":"^19.3.1","zod":"^3.25.0"},"description":"Self-hosted Meal Picker — Express + SQLite (Drizzle) API and Vite + React frontend","devDependencies":{"@tailwindcss/vite":"^4.3.3","@types/better-sqlite3":"^7.6.13","@types/express":"^4.17.23","@types/node":"^22.15.0","@types/react":"^19.3.0","@types/react-dom":"^19.3.0","@vitejs/plugin-react":"^6.1.2","tailwindcss":"^4.3.3","tsx":"^4.19.0","typescript":"^5.6.3","vite":"^8.3.4"},"engines":{"node":">=20"},"name":"meal-picker","private":true,"scripts":{"build":"npm run build:client && npm run build:server","build:client":"vite build --config client/vite.config.ts","build:server":"tsc -p tsconfig.json","dev":"vite --config client/vite.config.ts","dev:all":"sh -c 'npm run dev:server & server_pid=$!; trap \"kill $server_pid\" INT TERM EXIT; npm run dev'","dev:server":"tsx watch src/index.ts","seed":"tsx scripts/seed.ts","smoke":"node scripts/smoke.mjs","start":"node dist/index.js","test":"npm run test:unit && npm run smoke","test:unit":"tsx scripts/rating-weight.test.ts && tsx scripts/guest.test.ts","typecheck":"tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json"},"type":"module","version":"0.1.0"}
