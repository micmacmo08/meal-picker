# Copy to .env for local configuration. Never commit a real .env.

# Port the API listens on (production: Caddy proxies meals.digitaldwarf.dev -> localhost:3000)
PORT=3000

# SQLite file location. On the droplet this should live outside the repo,
# e.g. DATABASE_PATH=/var/lib/meal-picker/meal-picker.db
DATABASE_PATH=./data/meal-picker.db

# Shared password for mutating endpoints and calendar/shopping reads.
# Meal reads and the randomizer stay open. If unset, auth is DISABLED
# (local dev mode) and the server logs a warning at startup.
# MEAL_PICKER_PASSWORD=change-me

# Seed only: path to the OLD artifact app.db to import from.
# OLD_DB_PATH=/path/to/old/app.db
